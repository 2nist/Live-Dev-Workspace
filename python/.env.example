# Example configuration for live-dev-integration
# Copy this file to .env and customize as needed

# Ableton Live OSC Connection
LIVE_HOST=127.0.0.1
LIVE_OSC_SEND_PORT=11000
LIVE_OSC_RECEIVE_PORT=11001

# Logging
LOG_LEVEL=INFO
LOG_FILE=

# Default settings
DEFAULT_TEMPO=120
SCAN_ON_INIT=true

# Development
DEBUG=false
